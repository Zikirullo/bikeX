<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link
  href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@400;500;600&display=swap"
  rel="stylesheet"
/>

<body>
  <div class="logo-bar"></div>

  <div class="panel">
    <div class="bracket bracket-tl"></div>
    <div class="bracket bracket-tr"></div>
    <div class="bracket bracket-bl"></div>
    <div class="bracket bracket-br"></div>

    <div class="panel-inner">
      <!-- Panel header -->
      <div class="panel-head">
        <div class="dots">
          <div class="dot dot-r"></div>
          <div class="dot dot-o"></div>
          <div class="dot dot-g"></div>
        </div>

        <div class="panel-tag">NEW_ACCOUNT · REG_FORM</div>
        <div class="panel-tag" id="ts"></div>
      </div>

      <!-- Branding -->
      <div class="brand">
        <div class="brand-logo">
          <div class="brand-icon">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0a0a0a"
              stroke-width="3"
              stroke-linecap="round"
            >
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="18" r="3" />
              <path d="M14 6h-3l-3 6h9l-3-6z" />
              <path d="M6 15l3-6 2 4" />
            </svg>
          </div>

          <span class="brand-name"> Bike<span>Admin</span> </span>
        </div>

        <div class="brand-heading">CREATE <em>ACCOUNT</em></div>

        <div class="brand-sub">Register to access the control panel</div>
      </div>

      <!-- Form -->
      <div class="form-body">
        <form
          id="signupForm"
          action="/admin/signup"
          method="POST"
          enctype="multipart/form-data"
        >
          <!-- Profile image -->
          <div class="avatar-row">
            <div class="file-box">
              <img class="upload-img-frame" alt="Profile preview" />

              <input
                type="file"
                id="userImage"
                name="userImage"
                class="upload-hidden member-image"
                accept="image/jpg,image/jpeg,image/png"
                hidden
              />
            </div>

            <div class="avatar-info">
              <label> Profile Photo <span class="req">*</span> </label>

              <div class="avatar-hint">JPG, JPEG or PNG. Max 2 MB.</div>

              <div class="file-box-row">
                <input
                  type="text"
                  class="uploads-name"
                  placeholder="No file chosen"
                  readonly
                />

                <label for="userImage" class="avatar-btn file-box-btn">
                  Choose file
                </label>
              </div>
            </div>
          </div>

          <!-- Authentication method -->
          <input
            type="hidden"
            name="userAuth"
            class="member-auth"
            value="PHONE"
          />

          <div class="fields">
            <!-- ==================== -->
            <!-- Nickname              -->
            <!-- ==================== -->

            <div class="field">
              <div class="field-label">
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                >
                  <circle cx="12" cy="8" r="4" />
                  <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
                </svg>

                Nickname <span class="req">*</span>
              </div>

              <div class="input-wrap">
                <div class="input-icon">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
                  </svg>
                </div>

                <input
                  type="text"
                  name="userNick"
                  class="member-nick"
                  placeholder="e.g. riderX99"
                  maxlength="24"
                  autocomplete="username"
                />
              </div>
            </div>

            <!-- ==================== -->
            <!-- Phone                 -->
            <!-- ==================== -->

            <div class="field">
              <div class="field-label">
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                >
                  <path
                    d="M22 16.92v3a2 2 0 01-2.18 2A19.8 19.8 0 012.08 5.18 2 2 0 014.07 3h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 10.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0122 17z"
                  />
                </svg>

                Phone Number <span class="req">*</span>
              </div>

              <div class="input-wrap">
                <div class="input-icon">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path
                      d="M22 16.92v3a2 2 0 01-2.18 2A19.8 19.8 0 012.08 5.18 2 2 0 014.07 3h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 10.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0122 17z"
                    />
                  </svg>
                </div>

                <input
                  type="tel"
                  name="userPhone"
                  class="member-phone"
                  placeholder="+8201012345678"
                  autocomplete="tel"
                />
              </div>
            </div>

            <!-- ==================== -->
            <!-- Password              -->
            <!-- ==================== -->

            <div class="field">
              <div class="field-label">
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>

                Password <span class="req">*</span>
              </div>

              <div class="input-wrap">
                <div class="input-icon">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0110 0v4" />
                  </svg>
                </div>

                <input
                  type="password"
                  name="userPassword"
                  class="member-password"
                  placeholder="Min. 8 characters"
                  autocomplete="new-password"
                />

                <button
                  type="button"
                  class="pwd-toggle"
                  aria-label="Show password"
                >
                  SHOW
                </button>
              </div>

              <!-- Password strength -->
              <div class="strength-bar">
                <div class="strength-seg"></div>
                <div class="strength-seg"></div>
                <div class="strength-seg"></div>
                <div class="strength-seg"></div>
              </div>

              <div class="strength-label">—</div>
            </div>

            <!-- ==================== -->
            <!-- Confirm Password      -->
            <!-- ==================== -->

            <div class="field">
              <div class="field-label">
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>

                Confirm Password <span class="req">*</span>
              </div>

              <div class="input-wrap">
                <div class="input-icon">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0110 0v4" />
                  </svg>
                </div>

                <input
                  type="password"
                  name="confirmPassword"
                  class="confirm-password"
                  placeholder="Repeat password"
                  autocomplete="new-password"
                />
              </div>
            </div>
          </div>
          <!-- /fields -->

          <!-- Divider -->
          <div class="divider">
            <div class="divider-line"></div>

            <div class="divider-text">◆ Create account ◆</div>

            <div class="divider-line"></div>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn-submit" id="submitBtn">
            <span class="btn-text"> REGISTER &rarr; </span>

            <div class="spinner"></div>
          </button>

          <!-- Flash message -->
          <div class="flash" id="flashMsg"></div>
        </form>

        <!-- Login -->
        <div class="login-link">
          Already have an account?
          <a href="/login">Sign in</a>
        </div>
      </div>
    </div>
    <!-- /panel-inner -->
  </div>
  <!-- /panel -->

  <!-- Ticker -->
  <div class="ticker-wrap">
    <div class="ticker-track" id="ticker"></div>
  </div>

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <!-- Signup JS -->
  <script src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
