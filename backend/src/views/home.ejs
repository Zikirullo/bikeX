<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />

<body>
  <div class="navigation-menu">
    <ul class="nav justify-content-center">
      <li class="nav-item" style="cursor: pointer">
        <a class="nav-link active" href="/admin">Home</a>
      </li>
      <% if (!user) { %>
      <li class="nav-item" style="cursor: pointer">
        <a class="nav-link" href="/admin/signup">Signup</a>
      </li>
      <li class="nav-item" style="cursor: pointer">
        <a class="nav-link" href="/admin/login">Login</a>
      </li>
      <% } else { %>
      <li class="nav-item" style="cursor: pointer">
        <a class="nav-link" href="/admin/user/all">Users</a>
      </li>
      <li class="nav-item" style="cursor: pointer">
        <a class="nav-link" href="/admin/bikes/all">Bikes</a>
      </li>
      <li
        class="nav-item"
        style="cursor: pointer"
        onclick="return confirm('Do you want to logout?')"
      >
        <a class="nav-link" href="/admin/logout">Logout</a>
      </li>
      <% } %>
    </ul>
  </div>

  <div class="panel">
    <div class="corner-bl"></div>
    <div class="corner-br"></div>

    <!-- Header bar -->
    <div class="panel-header">
      <div class="dots">
        <div class="dot dot-r"></div>
        <div class="dot dot-o"></div>
        <div class="dot dot-g"></div>
      </div>
      <div class="panel-id">ADMIN_PANEL_v2.4.1</div>
      <div class="panel-stats">
        <span>CPU: 34%</span>
        <span>MEM: 61%</span>
      </div>
    </div>

    <!-- Title -->
    <div class="title-block">
      <div class="subtitle">◆ Control Center ◆</div>
      <div class="title">ADMIN<br /><span>PANEL</span></div>
    </div>

    <!-- Machinery stage -->
    <div class="stage">
      <!-- Top row -->
      <div class="row">
        <!-- Left piston -->
        <div class="piston-wrap" id="pistonA">
          <div
            class="piston-rod"
            id="rodA1"
            style="
              height: 48px;
              background: linear-gradient(to bottom, #f97316, #c2410c);
            "
          ></div>
          <div class="piston-body"></div>
          <div
            class="piston-base"
            id="rodA2"
            style="
              height: 32px;
              background: linear-gradient(to bottom, #c2410c, #7c2d12);
            "
          ></div>
        </div>

        <!-- Gear large left -->
        <canvas class="gear" id="gearA" width="100" height="100"></canvas>

        <!-- Center bolt -->
        <div class="bolt-wrap">
          <div class="pulse-ring"></div>
          <div class="bolt"></div>
        </div>

        <!-- Gear large right -->
        <canvas class="gear" id="gearB" width="100" height="100"></canvas>

        <!-- Right piston -->
        <div class="piston-wrap" id="pistonB">
          <div
            class="piston-rod"
            id="rodB1"
            style="
              height: 48px;
              background: linear-gradient(to bottom, #f97316, #c2410c);
            "
          ></div>
          <div class="piston-body"></div>
          <div
            class="piston-base"
            id="rodB2"
            style="
              height: 32px;
              background: linear-gradient(to bottom, #c2410c, #7c2d12);
            "
          ></div>
        </div>
      </div>

      <!-- Connector -->
      <div class="connector" style="margin: 8px 0"></div>

      <!-- Bottom row -->
      <div class="row">
        <canvas class="gear" id="gearC" width="52" height="52"></canvas>

        <div class="chain" id="chainL"></div>

        <canvas class="gear" id="gearD" width="68" height="68"></canvas>

        <div class="chain" id="chainR"></div>

        <canvas class="gear" id="gearE" width="52" height="52"></canvas>
      </div>

      <!-- Readouts -->
      <div class="readouts">
        <div class="readout">
          <div class="readout-label">Engine</div>
          <div class="readout-value">ONLINE</div>
        </div>
        <div class="readout">
          <div class="readout-label">Power</div>
          <div class="readout-value">94%</div>
        </div>
        <div class="readout">
          <div class="readout-label">Status</div>
          <div class="readout-value">ACTIVE</div>
        </div>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="stats-bar">
      <div class="stat">
        <div class="stat-label">Active Bikes</div>
        <div class="stat-value">142</div>
        <div class="stat-delta">+3 today</div>
      </div>
      <div class="stat">
        <div class="stat-label">Registered Users</div>
        <div class="stat-value">2,891</div>
        <div class="stat-delta">+18 today</div>
      </div>
      <div class="stat">
        <div class="stat-label">Trips Today</div>
        <div class="stat-value">374</div>
        <div class="stat-delta">+47 today</div>
      </div>
      <div class="stat">
        <div class="stat-label">Revenue</div>
        <div class="stat-value">$8,240</div>
        <div class="stat-delta">+$320 today</div>
      </div>
    </div>
  </div>

  <!-- Ticker -->
  <div class="ticker-wrap">
    <div class="ticker-track" id="ticker"></div>
  </div>

  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
