<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <div class="users-container">
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin">Home</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin/user/all">Users</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/bikes/all">Bikes</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
      </ul>
    </div>

    <div class="users-frame">
      <div class="board">
        <div class="user-table">
          <span class="header-name" style="margin-bottom: 30px">
            ALL USERS
          </span>
          <table class="table table-hover table-sm">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">No</th>
                <th scope="col">Nickname</th>
                <th scope="col">Phone</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <!--  LOOP USERS: START  -->
            <% users.map(function (value, index) { %>
            <tbody style="background-color: #f97316;">
              <td><%= index + 1 %></td>
              <td><%= value.userNick %></td>
              <td><%= value.userPhone %></td>
              <td style="width: 13%">
                <select
                  class="spec-select user-status"
                  id="<%= value._id %>"
                >
                  <option
                    value="ACTIVE"
                    <%= value.userStatus === "ACTIVE" ? "selected" : "" %>
                  >
                    ACTIVE
                  </option>
                  <option
                    value="BLOCK"
                    <%= value.userStatus === "BLOCK" ? "selected" : "" %>
                  >
                    BLOCK
                  </option>
                  <option
                    value="DELETED"
                    <%= value.userStatus === "DELETED" ? "selected" : "" %>
                  >
                    DELETE
                  </option>
                </select>
              </td>
            </tbody>
            <% }) %>
            <!--  LOOP USERS: END  -->
          </table>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
